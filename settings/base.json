{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "8"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Workflow"
    ],
    "additionalDirectories": [
      "{{CLAUDE_HOME}}/workflows"
    ],
    "deny": [
      "Bash(cat *credentials*)",
      "Bash(type *credentials*)",
      "Read(**/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/.npmrc)"
    ]
  },
  "model": "opus",
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/pre-bash-guard.mjs\"",
            "timeout": 200,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-budget.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-model-guard.mjs\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/commit-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/artifact-ask.mjs\"",
            "timeout": 200,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/bash-writes.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/permission-timed-allow.mjs\"",
            "timeout": 800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/skill-router.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/mode.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/skill-router.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/recall-digest.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/workflow-resume-notice.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/disk-clean-start.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/mode.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "mode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/mode.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-memory-only.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/question-answered.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/workflow-register.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/post-edit.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/skill-router.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/commit-gate.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-budget.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/checkpoint.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/bash-writes.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/bash-writes.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/commit-gate.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/commit-gate.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/typecheck-gate.mjs\"",
            "timeout": 150
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/commit-gate.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/git-tidy-gate.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/ask-gate.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/final-reply-cap.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/status-deliver.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-budget.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/typecheck-gate.mjs\"",
            "timeout": 150
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/commit-gate.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/git-tidy-gate.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-budget.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/checkpoint.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/git-tidy-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "askUserQuestionTimeout": "10m",
  "statusLine": {
    "type": "command",
    "command": "node \"{{CLAUDE_HOME}}/statusline.mjs\"",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": false,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": false,
    "code-review-anthropics@anthropic-plugin-directory": false,
    "context7@anthropic-plugin-directory": false,
    "skill-creator@anthropic-plugin-directory": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "playwright@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": false,
    "claude-md-management@anthropic-plugin-directory": false,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": false,
    "figma@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": false,
    "code-modernization@anthropic-plugin-directory": false,
    "superdesign@anthropic-plugin-directory": false,
    "miro@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "low"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "worktree": {
    "baseRef": "head"
  }
}
