{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/pnpm-lock.yaml)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(cat *credentials*)",
      "Bash(type *credentials*)",
      "Read(**/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/.npmrc)"
    ]
  },
  "model": "opus",
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/pre-bash-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/agent-model-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/skill-router.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/mode.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/skill-router.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/mode.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "mode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/mode.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/post-edit.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/skill-router.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/typecheck-gate.mjs\"",
            "timeout": 150
          },
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/ask-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/typecheck-gate.mjs\"",
            "timeout": 150
          }
        ]
      }
    ]
  },
  "askUserQuestionTimeout": "60s",
  "statusLine": {
    "type": "command",
    "command": "node \"{{CLAUDE_HOME}}/statusline.mjs\""
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": false,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": false,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "skill-creator@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": false,
    "claude-md-management@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": true,
    "figma@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": false,
    "code-modernization@anthropic-plugin-directory": false,
    "superdesign@anthropic-plugin-directory": false,
    "miro@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "low"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false
}
