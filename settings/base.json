{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "CLAUDE_CODE_DISABLE_WORKFLOWS": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "100"
  },
  "disableWorkflows": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "autoContinueAtUsageLimit": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/git-tidy-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/disk-clean-start.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/project-merge.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/post-edit.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/notify.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{CLAUDE_HOME}}/hooks/notify.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "askUserQuestionTimeout": "5m",
  "statusLine": {
    "type": "command",
    "command": "node \"{{CLAUDE_HOME}}/statusline.mjs\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": false,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": false,
    "code-review-anthropics@anthropic-plugin-directory": false,
    "context7@anthropic-plugin-directory": false,
    "skill-creator@anthropic-plugin-directory": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "playwright@anthropic-plugin-directory": false,
    "github@anthropic-plugin-directory": false,
    "claude-md-management@anthropic-plugin-directory": false,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": false,
    "figma@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false,
    "code-modernization@anthropic-plugin-directory": false,
    "superdesign@anthropic-plugin-directory": false,
    "miro@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "security-review": "user-invocable-only",
    "ship-local": "user-invocable-only",
    "steward": "user-invocable-only",
    "update-config": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  }
}
