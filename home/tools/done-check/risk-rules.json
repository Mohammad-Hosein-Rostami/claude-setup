{
  "version": 2,
  "leftOut": ["(^|/)(tests?|__tests__)/", "\\.(test|spec)\\.[^/]+$", "\\.(md|mdx|markdown|txt|rst|adoc)$"],
  "classes": {
    "security": {
      "segments": ["sessions?", "tokens?", "secrets?", "guards?", "permissions?", "sandbox(es)?", "uploads?", "accounts?"],
      "words": ["auth", "authn", "authz", "authenticat(e|ed|es|ion|or)", "authoriz(e|ed|es|ation|er)", "oauth2?", "login", "logins", "logout", "signin", "jwts?", "csrf", "xsrf", "cors", "credentials?", "passwords?", "passwd", "keychains?", "crypto", "cookies?", "webhooks?", "sanitiz(e|ed|es|er|ers|ing|ation)"]
    },
    "data": {
      "paths": ["(^|/)(migrations?|prisma)/", "\\.sql$", "schema\\."]
    },
    "money": {
      "paths": ["payment", "invoice", "billing", "refund", "stripe", "wallet"]
    },
    "concurrency": {
      "paths": ["(^|[^a-z0-9])(un)?lock(s|ed|ing|file)?([^a-z0-9]|$)", "(^|[^a-z0-9])(mutex|semaphore|queue|worker|flock)(es|s)?([^a-z0-9]|$)"]
    },
    "gate": {
      "paths": ["^home/hooks/", "^home/tools/(land-lane|road|done-check)/"]
    }
  },
  "large": { "lines": 400, "files": 15 }
}
