{
  "name": "long-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs a job file of long, unattended Claude Code steps on LangGraph.js with a SQLite checkpoint per run.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@langchain/core": "1.5.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
